# Env riêng của kruzetech-task
PORT=3010

DATABASE_URL=jdbc:postgresql://localhost:5433/kruzetech_task
DB_USERNAME=kruzetech_task
DB_PASSWORD=kruzetech_task

# Phải giống hệt JWT_SECRET của kruzetech-auth (task chỉ verify token, không tự cấp)
JWT_SECRET=change-me-change-me-change-me-change-me

CORS_ORIGIN=*
SWAGGER_ENABLED=true
