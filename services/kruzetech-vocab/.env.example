# Env riêng của kruzetech-vocab
PORT=3020

DATABASE_URL=jdbc:postgresql://localhost:5433/kruzetech_vocab
DB_USERNAME=kruzetech_vocab
DB_PASSWORD=kruzetech_vocab

# Phải giống hệt JWT_SECRET của kruzetech-auth (vocab chỉ verify token, không tự cấp)
JWT_SECRET=change-me-change-me-change-me-change-me

CORS_ORIGIN=*
SWAGGER_ENABLED=true
