# Env riêng của kruzetech-auth (đọc tự động khi chạy trong thư mục service này, hoặc qua docker compose)
PORT=3000

# DB (mặc định khớp infra/postgres-init.sql; Docker compose tự ghi đè DATABASE_URL)
DATABASE_URL=jdbc:postgresql://localhost:5433/kruzetech_auth
DB_USERNAME=kruzetech_auth
DB_PASSWORD=kruzetech_auth

# JWT: mỗi secret tối thiểu 32 ký tự. JWT_SECRET phải giống hệt kruzetech-task.
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin (để trống thì /auth/firebase/login trả 401 "Firebase is not configured")
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Redis / cache (CACHE_TYPE=simple | redis)
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS: * hoặc danh sách origin cách nhau bằng dấu phẩy
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# Tạo sẵn tài khoản ADMIN khi cả hai cùng có giá trị
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
